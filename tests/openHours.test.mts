/**
 * 휴무일·영업시간 해석 (openHours)
 *
 * 케이스는 한국관광공사 API 실측값에서 뽑았다(코퍼스 149종 / 휴무일 42종).
 * 기대값은 두 명의 검증자가 소스를 독립적으로 따라가 동의한 것만 남겼다.
 * 판정이 틀리면 현장 입장 거부(헛걸음)로 이어지므로, 여기 실패는 곧 사용자 피해다.
 */
import { test } from 'node:test'
import assert from 'node:assert/strict'
import { judge, parseRules, isDangerousBreed, sizeOf } from '../lib/petTour'
import { restStatus, clean, todayLabel } from '../lib/openHours'
import type { Pet, PetRules, PetTourRaw } from '../lib/types'


// 코퍼스 168건 중 118건(70%)이 이 값. 서비스 판정의 절대 다수가 이 한 줄에 걸려 있어 회귀 시 피해가 가장 크다. 2026-09-07은 월요일이지만 요일과 무관하게 always 여야 한다.
test('연중무휴(최빈값 118건) — always 로 판정하고 라벨은 연중무휴', () => {
  assert.deepEqual(restStatus('연중무휴', new Date('2026-09-07T10:00:00+09:00')), { kind: 'always', label: '연중무휴' })
})

// 실제 detailIntro2 값. clean 이 <br>를 개행으로 바꾼 뒤 정규식이 여전히 매칭돼야 한다. clean 순서가 뒤바뀌면 always 를 놓치고 unknown 으로 떨어진다.
test('연중무휴<br>※ 전화문의 요망 — <br> 처리 후에도 always', () => {
  assert.deepEqual(restStatus('연중무휴<br>※ 자세한 사항은 전화문의 요망', new Date('2026-09-07T10:00:00+09:00')), { kind: 'always', label: '연중무휴' })
})

// unknown 일 때 사용자에게 그대로 노출되는 문자열이라 가독성이 곧 안전이다. <br>가 남아 있으면 화면에 태그가 그대로 보인다.
test('clean — <br> 를 개행으로 바꾸고 원문 두 줄을 보존', () => {
  assert.equal(clean('연중무휴<br>※ 자세한 사항은 전화문의 요망'), '연중무휴\n※ 자세한 사항은 전화문의 요망')
})

// 실제 값 '연중무휴 <br>※ 휴장시 공지'. 공백+태그 조합에서 앞 줄 끝 공백이 남으면 안 된다.
test('clean — <br> 앞 공백을 트림하고 빈 줄을 제거', () => {
  assert.equal(clean('연중무휴 <br>※ 휴장시 공지'), '연중무휴\n※ 휴장시 공지')
})

// detailIntro2 에서 restdate 필드가 아예 빠져 오는 장소가 있다. throw 하면 상세 패널 전체가 죽는다.
test('clean — undefined 입력은 빈 문자열', () => {
  assert.equal(clean(undefined), '')
})

// 필드 결손은 '영업 중'도 '휴무'도 아니다. always 로 새면 헛걸음, closed 로 새면 멀쩡한 장소를 막는다.
test('restdate 누락 — unknown 으로 안전하게 빠진다', () => {
  assert.deepEqual(restStatus(undefined, new Date('2026-09-07T10:00:00+09:00')), { kind: 'unknown' })
})

// 코퍼스에 실제로 존재하는 잘린 값. '연중무휴'로 짐작해 always 를 주면 근거 없는 영업중 단정이 된다. 원문 노출이 옳다.
test('\'연중무\' (절단된 실데이터) — 추측하지 않고 unknown', () => {
  assert.equal(restStatus('연중무', new Date('2026-09-07T10:00:00+09:00')).kind, 'unknown')
})

// 코드 버그 의심. 2026-09-25는 추석 당일(금). 원문이 괄호로 예외를 명시했는데 연중무휴 정규식이 먼저 걸려 always·라벨 '연중무휴'를 준다. 이 서비스가 막으려는 전형적 헛걸음(false-open).
test('\'연중무휴 (명절 당일 휴무)\' + 추석 당일 — always 라고 단정하면 안 된다', () => {
  assert.ok(restStatus('연중무휴 (명절 당일 휴무)', new Date('2026-09-25T10:00:00+09:00')).kind !== 'always')
})

// 코퍼스 2위(5건)이자 요일 규칙의 기본형. 2026-09-07은 월요일.
test('\'매주 월요일\' + 월요일 — closed', () => {
  assert.deepEqual(restStatus('매주 월요일', new Date('2026-09-07T10:00:00+09:00')), { kind: 'closed', label: '매주 월요일 휴무' })
})

// 가장 위험한 오판(열려 있는데 오늘 휴무)의 최소 회귀 가드. 2026-09-08은 화요일이라 이 장소는 정상 영업 중이다.
test('\'매주 월요일\' + 화요일 — closed 로 막으면 안 된다', () => {
  assert.deepEqual(restStatus('매주 월요일', new Date('2026-09-08T10:00:00+09:00')), { kind: 'unknown' })
})

// 실제 값. 2026-09-09은 수요일. 범위의 시작 요일이 인식돼야 한다.
test('요일 범위 \'매주 수요일~목요일\' + 수요일 — closed', () => {
  assert.deepEqual(restStatus('매주 수요일~목요일', new Date('2026-09-09T10:00:00+09:00')), { kind: 'closed', label: '매주 수요일 휴무' })
})

// 2026-09-10은 목요일. '수요일'만 잡고 '목요일'을 흘리면 목요일 방문자가 닫힌 문 앞에 선다. 현재는 두 요일이 모두 문자열에 적혀 있어 통과하지만, 범위 표기를 시작 요일만 보게 바꾸는 리팩터링을 막는 가드.
test('요일 범위 \'매주 수요일~목요일\' + 목요일 — 끝 요일도 closed', () => {
  assert.deepEqual(restStatus('매주 수요일~목요일', new Date('2026-09-10T10:00:00+09:00')), { kind: 'closed', label: '매주 목요일 휴무' })
})

// 코드 버그 의심(미탐). 실제 값이며 2026-09-09은 수요일 — 원문상 확실한 휴무일인데 '월요일'과 '금요일'만 매칭돼 unknown 으로 빠진다. 방향은 안전측(원문 노출)이지만 ~ 범위를 전개하지 않는 한계를 고정해 둔다.
test('요일 범위 \'매주 월요일~금요일\' + 수요일 — 범위 중간 요일도 closed 여야 한다', () => {
  assert.equal(restStatus('매주 월요일~금요일', new Date('2026-09-09T10:00:00+09:00')).kind, 'closed')
})

// 2026-09-12는 토요일. 평일 휴무 시설은 주말이 영업일이다. ~ 범위를 나중에 전개할 때 경계를 넘겨 토요일까지 닫아버리는 회귀를 막는다.
test('\'매주 월요일~금요일\' + 토요일 — 범위 밖은 막지 않는다', () => {
  assert.ok(restStatus('매주 월요일~금요일', new Date('2026-09-12T10:00:00+09:00')).kind !== 'closed')
})

// 실제 값. 2026-09-12는 토요일. 쉼표 나열형이며 주말 휴무는 반려동물 동반 나들이 수요와 정면으로 겹쳐 오판 비용이 크다.
test('\'매주 토요일, 일요일 정기휴무\' + 토요일 — closed', () => {
  assert.deepEqual(restStatus('매주 토요일, 일요일 정기휴무', new Date('2026-09-12T10:00:00+09:00')), { kind: 'closed', label: '매주 토요일 휴무' })
})

// 2026-09-06은 일요일. DAYS 배열의 0번 인덱스라 오프바이원 리팩터링에 가장 먼저 깨지는 자리다.
test('\'매주 토요일, 일요일 정기휴무\' + 일요일 — getDay()===0 경계', () => {
  assert.deepEqual(restStatus('매주 토요일, 일요일 정기휴무', new Date('2026-09-06T10:00:00+09:00')), { kind: 'closed', label: '매주 일요일 휴무' })
})

// 실제 값. 2026-09-07은 공휴일이 아닌 평범한 월요일이라 예외 조항이 발동하지 않는다. 예외를 못 읽어도 이 경우엔 결과가 옳다 — 기본선 고정.
test('\'매주 월요일 (단, 월요일이 공휴일인 경우 그 다음날 평일)\' + 평일 월요일 — closed', () => {
  assert.deepEqual(restStatus('매주 월요일 (단, 월요일이 공휴일인 경우 그 다음날 평일)', new Date('2026-09-07T10:00:00+09:00')), { kind: 'closed', label: '매주 월요일 휴무' })
})

// 코드 버그 의심 — 가장 위험한 오판. 2026-03-02는 삼일절(일) 대체공휴일 월요일이라 이날은 정상 개관하고 휴무가 다음날로 이동한다. 예외 조항을 못 읽고 '오늘 휴무'로 막으면 열려 있는 장소를 막는 false-closed 다. 최소한 unknown 으로 내려가 원문을 보여줘야 한다.
test('같은 값 + 공휴일 월요일(삼일절 대체공휴일) — 휴무일이 다음날로 밀리므로 closed 라고 막으면 안 된다', () => {
  assert.ok(restStatus('매주 월요일 (단, 월요일이 공휴일인 경우 그 다음날 평일)', new Date('2026-03-02T10:00:00+09:00')).kind !== 'closed')
})

// 코드 버그 의심. 실제 값이고 원문에 '개관'이라고 직접 적혀 있는데도 closed 를 준다. 예외 절이 있는 줄은 공휴일 여부를 모르는 이상 closed 로 단정할 근거가 없다.
test('\'매주 월요일 (단, 월요일이 법정공휴일일 시 개관)\' + 대체공휴일 월요일 — 원문이 \'개관\'이라고 못박은 날', () => {
  assert.ok(restStatus('매주 월요일 (단, 월요일이 법정공휴일일 시 개관)', new Date('2026-03-02T10:00:00+09:00')).kind !== 'closed')
})

// 코드 버그 의심. 실제 값. 어순이 '공휴일이 월요일인 경우'로 뒤집혀 있어 예외 파싱을 붙일 때도 놓치기 쉬운 표현. 결과는 위 케이스와 같은 false-closed.
test('\'매주 월요일 (단, 공휴일이 월요일인 경우 제외)\' + 대체공휴일 월요일 — \'제외\' = 휴무 규칙 미적용', () => {
  assert.ok(restStatus('매주 월요일 (단, 공휴일이 월요일인 경우 제외)', new Date('2026-03-02T10:00:00+09:00')).kind !== 'closed')
})

// 실제 값. 두 요일 나열 + 예외 절 + 슬래시 추가 규칙이 한 줄에 다 섞인 최악의 형태. 2026-09-07은 평일 월요일이라 예외 미발동.
test('\'매주 월요일, 화요일 (단, 공휴일…정상 운영) / 설·추석 당일\' + 월요일 — closed', () => {
  assert.deepEqual(restStatus('매주 월요일, 화요일 (단, 공휴일 및 대체 휴무일인 경우 정상 운영) / 설·추석 당일', new Date('2026-09-07T10:00:00+09:00')), { kind: 'closed', label: '매주 월요일 휴무' })
})

// 2026-09-08은 화요일. 괄호 예외 절과 슬래시 뒤 텍스트가 같은 줄에 있어도 두 번째 요일까지 수집돼야 한다.
test('같은 값 + 화요일 — 두 번째 나열 요일도 closed', () => {
  assert.deepEqual(restStatus('매주 월요일, 화요일 (단, 공휴일 및 대체 휴무일인 경우 정상 운영) / 설·추석 당일', new Date('2026-09-08T10:00:00+09:00')), { kind: 'closed', label: '매주 화요일 휴무' })
})

// 코드 버그 의심 — 최악의 false-closed. 2026-05-05는 어린이날(화)이고 원문은 공휴일이면 '정상 운영'이라고 한다. 나들이 수요가 연중 최고인 날에 열린 장소를 휴무로 표시한다.
test('같은 값 + 어린이날 화요일 — \'정상 운영\'이라 적힌 날을 막으면 안 된다', () => {
  assert.ok(restStatus('매주 월요일, 화요일 (단, 공휴일 및 대체 휴무일인 경우 정상 운영) / 설·추석 당일', new Date('2026-05-05T10:00:00+09:00')).kind !== 'closed')
})

// 실제 값. '매주'가 문장 맨 앞이 아니라 슬래시 뒤에 온다. 앵커를 ^매주 로 조이는 리팩터링이 들어오면 이 장소는 조용히 unknown 이 된다.
test('\'1월1일 / 매주 월요일 (단, …개관하고 다음 평일에 휴관)\' + 평일 월요일 — 앞에 다른 규칙이 붙어도 매주 규칙 인식', () => {
  assert.deepEqual(restStatus('1월1일 / 매주 월요일 (단, 월요일이 공휴일 또는 대체공휴일인 경우 개관하고 다음 평일에 휴관)', new Date('2026-09-07T10:00:00+09:00')), { kind: 'closed', label: '매주 월요일 휴무' })
})

// 실제 값. NTH 정규식(첫째|…|\d+\s*번째)이 '첫 번째'와 아슬아슬하게 비껴간다. NTH 를 '첫'까지 넓히는 순간 확실한 월요일 휴무가 unknown 으로 새므로 경계를 못 박는다.
test('\'…그 다음 첫 번째 비공휴일…\' + 월요일 — \'첫 번째\'를 몇째주로 오탐해 흘리면 안 된다', () => {
  assert.deepEqual(restStatus('매주 월요일 (단, 월요일이 공휴일인 경우 그 다음 첫 번째 비공휴일) / 1월 1일 / 설·추석 / 훈증 소독기간', new Date('2026-09-07T10:00:00+09:00')), { kind: 'closed', label: '매주 월요일 휴무' })
})

// 실제 값. 2026년 9월의 월요일은 7·14·21·28일이고 휴무는 28일뿐이다. 09-07을 휴무로 표시하면 열린 장소를 막는 명백한 오판.
test('\'매월 마지막 주 월요일\' + 첫째 월요일 — 오늘은 열려 있다', () => {
  assert.ok(restStatus('매월 마지막 주 월요일', new Date('2026-09-07T10:00:00+09:00')).kind !== 'closed')
})

// 실제 값. 요일 규칙과 요일 없는 규칙이 한 줄에 공존한다. 읽히는 절반은 정확히 읽어야 한다.
test('\'매주 월요일 / 공휴일\' + 월요일 — 슬래시 뒤 공휴일이 붙어도 요일 규칙은 살아 있다', () => {
  assert.deepEqual(restStatus('매주 월요일 / 공휴일', new Date('2026-09-07T10:00:00+09:00')), { kind: 'closed', label: '매주 월요일 휴무' })
})

// 실제 값. 날짜 기반 규칙은 이 함수의 범위 밖이며 always 로 오해하면 1월 1일에 헛걸음이 된다. unknown 으로 원문을 넘기는 것이 옳다.
test('\'1월 1일 / 설·추석 당일\' — 요일 표현이 없으면 unknown', () => {
  assert.deepEqual(restStatus('1월 1일 / 설·추석 당일', new Date('2026-09-07T10:00:00+09:00')), { kind: 'unknown' })
})

// 실제 값. 판정 불가를 판정 불가로 남겨야 사용자가 전화를 건다.
test('\'점포 별로 상이함\' — 자유 텍스트는 unknown', () => {
  assert.deepEqual(restStatus('점포 별로 상이함', new Date('2026-09-07T10:00:00+09:00')), { kind: 'unknown' })
})

// 실제 값. ※ 로 시작하는 안내문만 있는 케이스. 어떤 요일에 조회해도 상태가 흔들리면 안 된다.
test('\'※ 행사 및 전시마다 상이하므로 홈페이지 참조\' — unknown', () => {
  assert.equal(restStatus('※ 행사 및 전시마다 상이하므로 홈페이지 참조', new Date('2026-09-09T10:00:00+09:00')).kind, 'unknown')
})

// 실제 값. 2026-09-11은 금요일. 월/수/화 외 요일도 DAYS 인덱스가 맞는지 확인한다.
test('\'매주 금요일\' + 금요일 — closed', () => {
  assert.deepEqual(restStatus('매주 금요일', new Date('2026-09-11T10:00:00+09:00')), { kind: 'closed', label: '매주 금요일 휴무' })
})

// 코드 버그 의심 — 실전 false-closed. now.getDay() 가 실행 환경 로컬 TZ 를 쓴다. TZ=UTC 서버에서 이 시각은 2026-09-07T15:30Z 라 getDay()=1(월)이 되어 closed 를 반환한다(KST 로 돌리면 unknown). 화요일 새벽에 앱을 켠 사용자에게 열려 있는 장소가 
test('KST 새벽 00:30 — 서버 TZ 가 UTC 여도 화요일로 계산돼야 한다', () => {
  assert.equal(restStatus('매주 월요일', new Date('2026-09-08T00:30:00+09:00')).kind, 'unknown')
})
